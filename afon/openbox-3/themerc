# Geometry:

padding.height: 4
padding.width: 4
border.width: 4
window.client.padding.width: 1
window.client.padding.height: 1
window.handle.width: 4
menu.border.width: 2
menu.overlap.x: 0
menu.overlap.y: 0
menu.separator.width: 2

# Text:

